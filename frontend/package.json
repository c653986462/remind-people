{
  "name": "certificate-manager",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:build": "npm run build && electron-builder --win nsis --config electron-builder.cjs --publish never"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.11.5",
    "electron-updater": "^6.6.2",
    "vue": "^3.5.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0",
    "concurrently": "^9.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.4"
  },
  "main": "electron/main.cjs"
}
