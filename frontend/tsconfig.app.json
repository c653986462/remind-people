{
  "compilerOptions": {
    "target": "ES2020", "useDefineForClassFields": true, "module": "ESNext", "lib": ["ES2020", "DOM"],
    "moduleResolution": "bundler", "allowImportingTsExtensions": false, "verbatimModuleSyntax": true,
    "noEmit": true, "strict": true, "jsx": "preserve", "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}

