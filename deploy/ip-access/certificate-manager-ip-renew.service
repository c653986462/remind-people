[Unit]
Description=Renew Certificate Manager IP TLS certificate
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/opt/certificate-manager/.ip-certbot-venv/bin/certbot renew --cert-name certificate-manager-ip --config-dir /etc/letsencrypt-ip --work-dir /var/lib/letsencrypt-ip --logs-dir /var/log/letsencrypt-ip --quiet --no-random-sleep-on-renew
TimeoutStartSec=20min
