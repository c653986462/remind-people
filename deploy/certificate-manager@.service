[Unit]
Description=Certificate Manager %i web/API slot
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/certificate-manager
EnvironmentFile=/opt/certificate-manager/.env
EnvironmentFile=/etc/certificate-manager/slot-%i.conf
Environment=PYTHONPATH=/opt/certificate-manager/slots/%i
ExecStart=/opt/certificate-manager/.venv/bin/uvicorn app.main:app --app-dir /opt/certificate-manager/slots/%i --host 127.0.0.1 --port $PORT --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/certificate-manager/data
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
