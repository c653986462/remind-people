# 企业微信机器人 Webhook；留空则仅记录提醒，不发送微信消息
WECHAT_WORK_WEBHOOK_URL=
# 邮件提醒 SMTP 发信配置（只放在服务器 .env，填邮箱客户端授权码/应用专用密码，不是邮箱登录密码）
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
# 留空时默认使用 EMAIL_SMTP_USERNAME 作为发件地址
EMAIL_SMTP_FROM=
EMAIL_SMTP_USE_SSL=true
EMAIL_SMTP_STARTTLS=false
# 每天几点执行到期检查（24 小时制）
CHECK_HOUR=9
# 企业微信在事项日期当天几点提醒（北京时间）
WECHAT_DUE_REMINDER_HOUR=8
# 默认提前多少天提醒
DEFAULT_REMIND_DAYS=30
# 可选：SQLite 或 PostgreSQL 连接串；默认使用 ./data/certificates.db
DATABASE_URL=sqlite:///./data/certificates.db
# 允许访问 API 的前端来源，多个地址用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Local HTTP development only. Production must use HTTPS and set this to true.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Local development hosts. Replace with the public hostname(s) in production.
ALLOWED_HOSTS=localhost,127.0.0.1

